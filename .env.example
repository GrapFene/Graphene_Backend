# =============================================================================
# Graphene Backend — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# Never commit .env to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase
# Get these from: https://supabase.com/dashboard → project → Settings → API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key


# -----------------------------------------------------------------------------
# JWT
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret


# -----------------------------------------------------------------------------
# Server
# PORT        — the port the Express server listens on inside the container
# INSTANCE_URL — full public URL of this server (used in links/redirects)
#                REQUIRED — the server will crash on start if not set
# -----------------------------------------------------------------------------
PORT=3000
INSTANCE_URL=https://graphene.myvnc.com


# -----------------------------------------------------------------------------
# Federation — Identity
# INSTANCE_DOMAIN  — bare IP or domain of this server, no protocol, no trailing slash
#                    e.g.  20.75.49.34   or   graphene.example.com
#                    REQUIRED — the server will crash on start if not set
#
# FEDERATION_PRIVATE_KEY — secp256k1 private key used to sign all outbound
#                          federation envelopes (FederationEnvelope.signature).
#                          Generate a fresh keypair with:
#                            node -e "
#                              const {ethers}=require('ethers');
#                              const w=ethers.Wallet.createRandom();
#                              console.log('PRIVATE KEY:',w.privateKey);
#                              console.log('ADDRESS:',w.address);
#                            "
#                          Use a DIFFERENT key for every instance.
#                          REQUIRED — the server will crash on start if not set
# -----------------------------------------------------------------------------
INSTANCE_DOMAIN=20.75.49.34
FEDERATION_PRIVATE_KEY=0xYOUR_SECP256K1_PRIVATE_KEY_HERE


# -----------------------------------------------------------------------------
# Federation — Peers
# KNOWN_PEERS       — comma-separated list of peer instance domains to broadcast
#                     new posts to on startup / post creation.
#                     Leave blank if this is a standalone instance.
#                     e.g.  20.75.49.34,graphene2.example.com
#
# FEDERATION_TIMEOUT_MS — timeout in ms for outbound HTTP calls to peer inboxes
#                         default: 5000
# -----------------------------------------------------------------------------
KNOWN_PEERS=
FEDERATION_TIMEOUT_MS=5000
